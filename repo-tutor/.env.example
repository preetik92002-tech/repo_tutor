# Copy to .env.local and adjust. Never commit real secrets.
# Everything here is read on the server only (no NEXT_PUBLIC_ prefix on purpose).

# ---- Database (SQLite file, created automatically; migrations run on first use) ----
# Needs Node >= 22.13 (uses the built-in node:sqlite). Use a persistent disk in production.
DATABASE_PATH=data/repo-tutor.sqlite

# ---- AI inference via Ollama (powers only the optional "Ask the tutor" feature) ----
AI_PROVIDER=ollama
AI_BASE_URL=http://127.0.0.1:11434
AI_MODEL=gemma3:1b
AI_TIMEOUT_MS=120000
AI_MAX_INPUT_CHARS=12000
AI_MAX_OUTPUT_TOKENS=1024
AI_CONTEXT_TOKENS=4096
AI_TEMPERATURE=0.2
AI_MAX_CONCURRENT=1

# ---- GitHub ingestion (all optional) ----
# A token only raises GitHub's API rate limit (60/h anonymous). It is sent to api.github.com only.
# GITHUB_TOKEN=
GH_MAX_FILES=40
GH_MAX_FILE_BYTES=60000
GH_MAX_TOTAL_BYTES=600000
GH_MAX_TREE_ENTRIES=20000
GH_TIMEOUT_MS=15000
GH_CONCURRENCY=4

# ---- Abuse protection ----
# Multiplies every per-process rate limit (default 1).
# RATE_LIMIT_SCALE=1

# ---- Analysis jobs ----
ANALYSIS_MAX_CONCURRENT=2
ANALYSIS_TTL_HOURS=24
ANALYSIS_MAX_DURATION_MS=120000
